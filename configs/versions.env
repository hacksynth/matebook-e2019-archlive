# 所有网络输入的锁定信息。修改任何值时，必须同时审查来源并更新 README。
# shellcheck shell=bash

# 内核：Linux 官方 stable v7.3.4（上游 tag 与 peel 后的提交 SHA 双重锁定）。
# 主源用 GitHub 上的 stable 镜像（tag 对象与 kernel.org 完全一致），kernel.org 作回退；
# 两者都会核对同一个锁定提交，镜像不可信/漂移都会失败关闭。
LINUX_REPO="https://github.com/gregkh/linux.git"
LINUX_MIRROR="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
LINUX_REF="v7.3.4"
LINUX_COMMIT="7595a62d45ee1a2297eafa5f2ef5d0a45142d84d"

# Arch Linux ARM Generic AArch64 rootfs。ALARM 未提供日期化归档 URL；因此固定
# 2026-08-05 发布内容的官方 MD5，并强制校验其 OpenPGP 分离签名。上游 latest
# 一旦更新，构建会“失败关闭”，而不是静默使用新内容。
ALARM_ROOTFS_URL="http://fl.us.mirror.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz"
ALARM_ROOTFS_SIG_URL="http://fl.us.mirror.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz.sig"
ALARM_ROOTFS_MD5="23eec86365b24f7913c403e8f4e8719b"
ALARM_ROOTFS_LAST_MODIFIED="2026-08-05T12:41:36Z"
ALARM_BUILD_KEY_FINGERPRINT="68B3537F39A313B3E574D06777193F152BDBE6A6"
ALARM_KEYSERVER="hkps://keyserver.ubuntu.com"

VOLUME_LABEL="PAKAL09_LIVE"
IMAGE_BASENAME="matebook-e2019-archlive-7.3.4"
LINUX_SOURCE_ARCHIVE="linux-source-7.3.4.tar.zst"
