#!/usr/bin/bash
set -euo pipefail

# WCN3990 on PAK-AL09 reports an all-zero BD_ADDR. BlueZ then marks the
# controller as unconfigured and desktop Bluetooth panels cannot see it.
for _ in {1..120}; do
    [[ -e /sys/class/bluetooth/hci0 ]] && break
    sleep 1
done
[[ -e /sys/class/bluetooth/hci0 ]] || exit 1

controller_present() {
    /usr/bin/bluetoothctl show 2>/dev/null |
        grep -Eq '^Controller ([0-9A-Fa-f]{2}:){5}'
}

controller_present && exit 0

hash=$(sha256sum /etc/machine-id | cut -c1-10)
address="02:${hash:0:2}:${hash:2:2}:${hash:4:2}:${hash:6:2}:${hash:8:2}"

for _ in {1..60}; do
    /usr/bin/btmgmt --index 0 public-addr "${address}" >/dev/null 2>&1 || true
    for _ in {1..5}; do
        controller_present && exit 0
        sleep 1
    done
done

exit 1
