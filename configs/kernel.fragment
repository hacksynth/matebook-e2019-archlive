# Live 介质必需功能
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_SNAPSHOT=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_UTF8=y
CONFIG_VFAT_FS=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# dracut 以 zstd 压缩 initramfs，内核必须能解压；同时保留 gzip 作为回退。
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_DECOMPRESS_ZSTD=y

# 压缩已安装模块，显著减小 squashfs/ISO/raw 体积（kmod 与 dracut 均支持）。
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_ALL=y

# USB/SD 启动介质；UFS 为内部存储（默认不自动挂载）
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=m

# USB-C / Type-C（v7.3.4 上游驱动；不再需要 6.16 的 Planck EC/UCSI 补丁）
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_TYPEC_DP_ALTMODE=m

# 该机型的上游显示/触控链路（eDP 面板 + TI SN65DSI86 + Adreno）
CONFIG_DRM_PANFROST=m
CONFIG_DRM_TI_SN65DSI86=m
CONFIG_DRM_PANEL_EDP=m
CONFIG_I2C_HID_OF=m

# 用户空间与网络
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=m
CONFIG_PACKET=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
