[Unit]
Description=Start Qualcomm MSS for WCN3990 WLAN
Wants=rmtfs.service pd-mapper.service tqftpserv.service
After=rmtfs.service pd-mapper.service tqftpserv.service systemd-modules-load.service
Before=ath10k-wcn3990.service NetworkManager.service
ConditionPathExists=/sys/class/remoteproc

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/start-qcom-mss
TimeoutStartSec=90s
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
