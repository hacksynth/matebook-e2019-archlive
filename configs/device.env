# 目标实机基线。2026-11-13 在 HUAWEI PAK-AL09（M1010）上核对。
# 不记录设备序列号、UUID 或其他唯一标识。
# shellcheck shell=bash

DEVICE_VENDOR="HUAWEI"
DEVICE_PRODUCT="MateBook E 2019"
DEVICE_MODEL="PAK-AL09"
DEVICE_PRODUCT_VERSION="M1010"
DEVICE_SOC="Snapdragon 850"
DEVICE_MEMORY="8 GiB"
DEVICE_DISPLAY="2160x1440"
DEVICE_INTERNAL_STORAGE="UFS"
DEVICE_TOUCHSCREEN="Goodix GT7380 (I2C-HID)"
DEVICE_WIFI_BLUETOOTH="Qualcomm WCN3990 (ath10k + QCA UART)"
DEVICE_BIOS_BASELINE="1.15 (2019-04-26)"

# 板级支持：Linux stable v7.3.4 已包含该机型设备树，无需外部补丁。
DEVICE_DTB="qcom/sdm850-huawei-matebook-e-2019.dtb"
DEVICE_FIRMWARE_ROOT="qcom/sdm850/HUAWEI/AL09"
